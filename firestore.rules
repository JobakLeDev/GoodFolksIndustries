rules_version = '2';

// ============================================================
//  Goodfolks Industries — règles Firestore
//  À publier dans la console Firebase :
//  Firestore Database → Règles → coller → Publier
// ============================================================
//
//  ⚠️ LIRE CECI. Ce jeu n'utilise PAS Firebase Auth (la connexion est
//  « nom + code », vérifiée dans le navigateur). Firestore ne peut donc
//  pas savoir QUI écrit : n'importe qui ouvrant la console de son
//  navigateur peut lire les codes d'accès, les bulletins de vote, les
//  OBJECTIFS SECRETS DES ÉQUIPES, et modifier son nombre de parts.
//
//  C'est un compromis assumé pour un week-end entre 40 personnes
//  consentantes. Ce que ça implique concrètement :
//    · ne mets AUCUNE donnée personnelle réelle dans ces documents ;
//    · le code du guichet (admin.html) est un verrou de confort ;
//    · le scrutin n'est pas secret au sens technique — il l'est au sens
//      social : rien dans l'interface ne révèle un bulletin avant le
//      dépouillement ;
//    · après le week-end, repasse tout en
//      `allow read, write: if false;` (ou supprime le projet).
//
//  Si tu rejoues ce jeu avec des inconnus : activer Firebase Auth
//  (anonyme), stocker l'uid dans /players/{id}.uid, et déplacer les
//  mouvements de parts + le dépouillement dans des Cloud Functions,
//  seules habilitées à écrire `shares`, `/ledger` et `/vote`.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Comptes actionnaires. `shares` = parts EN BANQUE.
    match /players/{playerId} {
      allow read, write: if true;
    }

    // Grand livre des mouvements de parts. Écrit par les transactions
    // du client ; jamais réécrit (l'historique ne se retouche pas).
    match /ledger/{entryId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // File d'attente du guichet (retrait / dépôt de jetons).
    match /requests/{reqId} {
      allow read, write: if true;
    }

    // Bulletins. Un document par actionnaire : la page joueur ne lit
    // que le sien, et le doc /vote/current ne porte jamais le contenu
    // d'un bulletin — seulement la liste de qui a voté.
    match /ballots/{playerId} {
      allow read, write: if true;
    }

    // Le scrutin : /vote/current
    match /vote/{docId} {
      allow read, write: if true;
    }

    // Équipes : cagnotte, objectif secret, couleur.
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Motions de dépense d'équipe (5 minutes, le silence vaut accord).
    match /motions/{motionId} {
      allow read, write: if true;
    }

    // Activités possédées par une équipe, et leur péage.
    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Inscriptions : une place sur un créneau, ou un ticket dans une file.
    match /signups/{signupId} {
      allow read, write: if true;
    }

    // Programme du week-end : /schedule/data = { items: [...] }
    match /schedule/{docId} {
      allow read, write: if true;
    }

    // Commandes à remettre (perso ou équipe).
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Catalogue du shop : /shop/catalog = { items: [...] }
    match /shop/{docId} {
      allow read, write: if true;
    }

    // Communiqués : /journal/public = { entries: [...] }
    match /journal/{docId} {
      allow read, write: if true;
    }

    // Plan : /map/data = { pois: [...] }
    match /map/{docId} {
      allow read, write: if true;
    }

    // Réglages et trésorerie : /config/game, /config/treasury
    match /config/{docId} {
      allow read, write: if true;
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
